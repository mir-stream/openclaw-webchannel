{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  // `*.test-harness.ts` is test scaffolding, NOT public API: it does not match
  // `*.test.ts`, so it was being compiled into the published dist.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/**/*.test-harness.ts"]
}
