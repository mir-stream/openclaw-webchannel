{
  "name": "openclaw-webchannel-saas",
  "version": "0.6.1",
  "description": "Headless SaaS trust chain core + reference harness for WebChannel NATS relay",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mir-stream/openclaw-webchannel.git",
    "directory": "packages/saas"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "setup-trust-chain": "tsx ./reference/setup-trust-chain.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@nats-io/jwt": "0.0.10-5",
    "@nats-io/nkeys": "2.0.3"
  }
}
