{
  "name": "openclaw-webchannel",
  "version": "0.0.0",
  "description": "Self-hosted web chat channel plugin for OpenClaw (Phase 0 walking skeleton).",
  "private": true,
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index-nats.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "webchannel",
      "label": "WebChannel",
      "blurb": "Self-hosted web chat channel served on the gateway port."
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.6.10"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "openclaw": "2026.6.10",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
