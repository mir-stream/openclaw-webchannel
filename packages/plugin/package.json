{
  "name": "openclaw-webchannel",
  "version": "0.6.0",
  "description": "Self-hosted web chat channel plugin for OpenClaw: E2E-encrypted browser chat over a NATS relay.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mir-stream/openclaw-webchannel.git",
    "directory": "packages/plugin"
  },
  "files": [
    "dist",
    "index-nats.ts",
    "setup-entry.ts",
    "rotate-key-entry.ts",
    "openclaw.plugin.json",
    "README.md"
  ],
  "bin": {
    "openclaw-webchannel-rotate-key": "./dist/rotate-key-entry.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index-nats.js"
    ],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "webchannel",
      "label": "WebChannel",
      "selectionLabel": "WebChannel (self-hosted web chat)",
      "docsPath": "https://github.com/mir-stream/openclaw-webchannel#readme",
      "blurb": "Self-hosted, end-to-end encrypted browser chat over NATS."
    },
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": "2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild index-nats.ts setup-entry.ts rotate-key-entry.ts --bundle --platform=node --format=esm --target=es2023 --outdir=dist --packages=external"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
