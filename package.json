{
  "name": "webchannel-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:inventory": "node scripts/check-test-inventory.mjs",
    "test:inventory:update": "node scripts/check-test-inventory.mjs --update",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:demo && npm run typecheck:e2e",
    "typecheck:demo": "tsc -p demo/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "build": "npm run build --workspaces --if-present"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
