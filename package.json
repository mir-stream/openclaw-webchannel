{
  "name": "webchannel-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:demo",
    "typecheck:demo": "tsc -p demo/tsconfig.json",
    "build": "npm run build --workspaces --if-present"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.0"
  }
}
